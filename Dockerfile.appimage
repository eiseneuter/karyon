FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8

# Add KDE Neon repository for Qt 6.7 & KF6 on Ubuntu 22.04 LTS (Jammy) with glibc 2.35
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    gnupg \
    ca-certificates \
    && curl -s http://archive.neon.kde.org/public.key | gpg --dearmor -o /etc/apt/trusted.gpg.d/neon.gpg \
    && echo 'deb http://archive.neon.kde.org/user jammy main' > /etc/apt/sources.list.d/neon.list \
    && apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    ninja-build \
    file \
    wget \
    tar \
    desktop-file-utils \
    patchelf \
    librsvg2-bin \
    extra-cmake-modules \
    qt6-base-dev \
    qt6-declarative-dev \
    libqt6svg6-dev \
    qml6-module-qtquick-controls \
    qml6-module-qtquick-layouts \
    qml6-module-qtquick-templates \
    qml6-module-qtquick-dialogs \
    kf6-kwindowsystem-dev \
    kf6-kservice-dev \
    kf6-kio-dev \
    libsqlite3-dev \
    libxcb1-dev \
    libxcb-shape0-dev \
    libxcb-cursor-dev \
    libxcb-image0-dev \
    libxcb-keysyms1-dev \
    libxcb-render-util0-dev \
    libxcb-util-dev \
    libxkbcommon-dev \
    libxkbcommon-x11-dev \
    && rm -rf /var/lib/apt/lists/*

# Download and extract appimagetool so FUSE is not required inside Docker
RUN mkdir -p /opt/appimagetool \
    && wget -q -O /tmp/appimagetool https://github.com/AppImage/appimagetool/releases/download/continuous/appimagetool-x86_64.AppImage \
    && chmod +x /tmp/appimagetool \
    && cd /tmp && /tmp/appimagetool --appimage-extract \
    && mv /tmp/squashfs-root/* /opt/appimagetool/ \
    && rm -rf /tmp/appimagetool /tmp/squashfs-root \
    && ln -s /opt/appimagetool/AppRun /usr/local/bin/appimagetool

# Download uruntime for standalone FUSE-optional execution on target machines
RUN mkdir -p /opt/uruntime \
    && wget -q -O /opt/uruntime/uruntime-appimage-squashfs-x86_64 https://github.com/VHSgunzo/uruntime/releases/latest/download/uruntime-appimage-squashfs-x86_64 \
    && chmod +x /opt/uruntime/uruntime-appimage-squashfs-x86_64

WORKDIR /src

CMD ["./build_appimage.sh"]
